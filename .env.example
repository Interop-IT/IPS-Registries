# Copy to .env and supply public Google Sheets URLs or IDs.
# Each registry can use its own spreadsheet.
IPS_IMPLEMENTATIONS_SHEETS_URL=https://docs.google.com/spreadsheets/d/YOUR_IMPLEMENTATIONS_SHEET_ID/edit
VENDOR_RESULTS_SHEETS_URL=https://docs.google.com/spreadsheets/d/YOUR_VENDOR_RESULTS_SHEET_ID/edit

# Optional legacy fallback when a dedicated registry URL is unset.
# GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/YOUR_FALLBACK_SHEET_ID/edit

# Optional return-link destination (same tab on desktop and mobile).
IPS_RETURN_URL=https://international-patient-summary.net/content-all-ips/ips-implementation-registry/
PORT=5000
